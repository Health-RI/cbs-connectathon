                healthdcatap:trustedDataHolder true;
                foaf:homepage <https://www.cbs.nl>;
                foaf:name "Centraal Bureau voor de Statistiek"
            ];
    dct:spatial code:NL;
    dct:temporal [ a dct:PeriodOfTime; dcat:startDate "2015-01-01"^^xsd:date ];
    dct:title
